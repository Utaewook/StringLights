# Python / Backend
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
.coverage
htmlcov/

# Temporary Surgery & Model Files
# Every request is staged under apps/backend/temp/<uuid>/ — the uploaded zip, the
# extracted model, and the response zip. Ignore the root rather than a filename
# pattern: the temp_in_* / temp_out_* rules this replaces named paths the code had
# stopped producing, and nothing noticed. A rule tied to a directory the code
# actually reads from cannot drift the same way.
apps/backend/temp/
*.onnx
*.onnx.data
*.wasm

# Node.js / Frontend
node_modules/
dist/
.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ONNX Runtime Web auto-copied files
apps/web-app/public/ort*.mjs

# Incoming asset drops. Whatever the project keeps is committed to its real home —
# the icon pack's SVG sources live in apps/web-app/src/assets/icon/.
handoffs/
